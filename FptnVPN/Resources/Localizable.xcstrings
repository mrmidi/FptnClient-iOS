    "Runtime reconnect now happens inside the packet tunnel provider. Auto-Reconnect controls the retry budget and delay, while Tunnel idle timeout controls how quickly the websocket is treated as dead." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Runtime reconnect now happens inside the packet tunnel provider. Auto-Reconnect controls the retry budget and delay, while Tunnel idle timeout controls how quickly the websocket is treated as dead." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Переподключение происходит внутри расширения туннеля. Автопереподключение управляет бюджетом попыток и задержкой, а таймаут бездействия — как быстро WebSocket считается мёртвым." } }
      }
    },
